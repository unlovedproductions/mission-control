# Mission Control backend — copy to backend/.env and adjust for local use.
# Service URLs are stored in SQLite Settings; only secrets belong here.

# Shared with APF and ShadowCast (must match all three repos)
INTERNAL_SERVICE_SECRET=change-me-local-secret

# Optional overrides
# MC_DB_PATH=/path/to/mission_control.db
# MC_MAX_CONCURRENT_JOBS=2
# MC_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
# Optional operator gate (required for publish-capable installs)
# MC_DASHBOARD_TOKEN=

# Sentry (errors, tracing, logs). Leave unset to disable.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
